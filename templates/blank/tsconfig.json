{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "bustatic": [
        "./node_modules/bustatic/dist/index.d.ts",
        "./.bustatic/types/index.d.ts"
      ]
    }
  },
  "include": ["src/**/*", "bustatic.config.ts"]
}
