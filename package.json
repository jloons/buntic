{
  "name": "bustatic",
  "version": "0.3.0",
  "description": "Zero-dependency, blazing-fast static site generator native to Bun",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "bustatic": "./bin/bustatic.ts"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "dev": "bun ./bin/bustatic.ts dev examples/simple --port 3333",
    "build": "bun ./bin/bustatic.ts build examples/simple"
  },
  "keywords": [
    "bun",
    "ssg",
    "static-site-generator",
    "zero-dependencies",
    "htmlrewriter",
    "web-components"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "bun": ">=1.0.0"
  }
}
