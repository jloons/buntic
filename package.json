{
  "name": "bustatic",
  "version": "0.3.0",
  "description": "Zero-dependency, blazing-fast static site generator native to Bun",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "bustatic": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:pkg": "bun run scripts/build-package.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build:pkg && bun test",
    "dev": "bun ./bin/bustatic.ts dev examples/simple --port 3333",
    "build": "bun ./bin/bustatic.ts build examples/simple"
  },
  "keywords": [
    "bun",
    "ssg",
    "static-site-generator",
    "zero-dependencies",
    "htmlrewriter",
    "web-components"
  ],
  "author": "j-loon <joselow.c.m@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jloons/bustatic.git"
  },
  "homepage": "https://github.com/jloons/bustatic#readme",
  "bugs": {
    "url": "https://github.com/jloons/bustatic/issues"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  }
}
